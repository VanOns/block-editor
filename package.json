{
  "name": "@infobipcth/block-editor",
  "version": "2.0.0",
  "description": "A standalone implementation of the WordPress Block Editor",
  "main": "dist/index.js",
  "module": "dist/index.js",
  "types": "dist/index.d.ts",
  "publishConfig": {
    "registry": "https://npm.pkg.github.com"
  },
  "keywords": [
    "block",
    "editor",
    "gutenberg",
    "block-editor"
  ],
  "author": "Maurice Wijnia",
  "contributors": [
    "Denis Žoljom"
  ],
  "license": "GPL-2.0-or-later",
  "files": [
    "dist/"
  ],
  "scripts": {
    "clean": "rm -rf dist",
    "watch": "npm run build:ts -- --watch & npm run build:sass -- --watch",
    "start": "vite playground",
    "prebuild": "npm run clean",
    "build": "npm run build:ts && npm run build:sass",
    "build:sass": "sass src/styles.scss dist/styles.css",
    "build:ts": "tsc",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "prepare": "npm run build"
  },
  "dependencies": {
    "@wordpress/api-fetch": "^7.49.0",
    "@wordpress/block-editor": "^15.22.0",
    "@wordpress/block-library": "^9.48.1",
    "@wordpress/blocks": "^15.22.0",
    "@wordpress/components": "^32.6.0",
    "@wordpress/data": "^10.49.0",
    "@wordpress/element": "^6.46.0",
    "@wordpress/format-library": "^5.49.0",
    "@wordpress/hooks": "^4.49.0",
    "@wordpress/keyboard-shortcuts": "^5.49.0",
    "@wordpress/server-side-render": "^6.25.0",
    "axios": "^1.18.1",
    "uuid": "^13.0.2"
  },
  "devDependencies": {
    "@vitest/coverage-v8": "^4.1.9",
    "jsdom": "^29.1.1",
    "sass": "^1.101.0",
    "typescript": "^6.0.3",
    "vite": "^8.1.0",
    "vitest": "^4.1.9"
  },
  "peerDependencies": {
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "overrides": {
    "form-data": ">=4.0.6",
    "picomatch": ">=2.3.2"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/infobipcth/block-editor.git"
  },
  "bugs": {
    "url": "https://github.com/infobipcth/block-editor/issues"
  },
  "homepage": "https://github.com/infobipcth/block-editor#readme"
}
